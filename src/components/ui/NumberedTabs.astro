---
// Numbered panels ("01 / 04") with a tab row above them. The HTML shows every panel stacked, so it reads fine
// without JavaScript; the script below turns it into tabs (arrow keys, Home, and End move between them).
//   label : accessible name for the tab row
//   items : one panel each. `statement` is the large line; `body` and `meta` sit under it.
interface Props {
  label: string;
  items: {
    id: string;
    title: string;
    statement: string;
    body?: string;
    meta?: string;
    Icon?: (props: Record<string, unknown>) => unknown;
  }[];
}

const { label, items } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<numbered-tabs class="block">
  <div role="tablist" aria-label={label} hidden data-tablist class="grid grid-cols-2 border-b border-line sm:grid-cols-4">
    {items.map(({ id, title }, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${id}`}
        aria-controls={`panel-${id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="group relative py-3 pr-4 text-left text-slate hover:text-white aria-selected:text-white
          after:absolute after:inset-x-0 after:-bottom-px after:h-0.5 after:bg-clay after:opacity-0 aria-selected:after:opacity-100"
      >
        <span class="mr-2 font-mono text-sm text-slate group-aria-selected:text-clay">{pad(i + 1)}</span>{title}
      </button>
    ))}
  </div>

  <div class="space-y-4 [[data-enhanced]_&]:mt-6 [[data-enhanced]_&]:space-y-0">
    {items.map(({ id, title, statement, body, meta, Icon }, i) => (
      <div
        id={`panel-${id}`}
        data-panel
        class="grid min-h-72 gap-6 rounded-sm bg-prussian p-6 sm:p-8 md:grid-cols-[6rem_minmax(0,1fr)_auto]"
      >
        <div class="flex items-baseline justify-between md:flex-col md:items-start">
          <p class="font-mono text-sm text-slate">{pad(i + 1)} / {pad(items.length)}</p>
          <p aria-hidden="true" class="font-display text-6xl leading-none text-clay md:text-8xl">{i + 1}</p>
        </div>
        <div class="min-w-0">
          <h3 class="font-mono text-xs tracking-wider text-white uppercase">{title}</h3>
          <p class="mt-3 max-w-[40ch] text-2xl leading-snug text-balance text-white">{statement}</p>
          {body && <p class="mt-4 max-w-[60ch] text-pretty text-alice/80">{body}</p>}
          {meta && <p class="mt-4 text-sm text-slate">{meta}</p>}
        </div>
        {Icon && <Icon class="hidden size-20 text-dusk md:block" stroke-width={1} aria-hidden="true" />}
      </div>
    ))}
  </div>
</numbered-tabs>

<script>
  class NumberedTabs extends HTMLElement {
    connectedCallback() {
      const tablist = this.querySelector<HTMLElement>('[data-tablist]');
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...this.querySelectorAll<HTMLElement>('[data-panel]')];
      if (!tablist || tabs.length !== panels.length) return;

      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          const on = i === index;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          panels[i].hidden = !on;
        });
        if (focus) tabs[index].focus();
      };

      panels.forEach((panel, i) => {
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tabs[i].id);
        panel.tabIndex = 0;
      });
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(i));
        tab.addEventListener('keydown', (event) => {
          const last = tabs.length - 1;
          const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[
            event.key
          ];
          if (next === undefined) return;
          event.preventDefault();
          select(next, true);
        });
      });

      tablist.hidden = false;
      this.dataset.enhanced = '';
      select(0);
    }
  }

  customElements.define('numbered-tabs', NumberedTabs);
</script>
