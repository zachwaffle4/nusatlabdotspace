---
// Layout for MDX pages in src/pages/. Set these in the page's frontmatter:
//   title (tab/SEO title), description, heading (the h1), lead (intro paragraph),
//   and for subpages, label + labelHref (the bracketed parent link above the lead, e.g. "Projects").
import BaseLayout from './BaseLayout.astro';
import PageIntro from '../components/layout/PageIntro.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    heading: string;
    lead?: string;
    label?: string;
    labelHref?: string;
  };
}

const { title, description, heading, lead, label, labelHref } = Astro.props.frontmatter;
---

<BaseLayout {title} {description}>
  <PageIntro title={heading} {label} {labelHref}>{lead}</PageIntro>
  <slot />
</BaseLayout>
